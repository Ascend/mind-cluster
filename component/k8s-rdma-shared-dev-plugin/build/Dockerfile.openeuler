FROM openeuler/openeuler:24.03-lts

RUN yum update -y && \
    yum install -y shadow-utils libmnl-devel && \
    yum clean all && \
    rm -rf /var/cache/yum && \
    rm -rf /tmp/*

# libdcmi.so is dynamically loaded from the driver installed on the host, which is mounted at the same path.
ENV LD_LIBRARY_PATH /usr/local/Ascend/driver/lib64:/usr/local/Ascend/driver/lib64/driver:/usr/local/Ascend/driver/lib64/common

RUN usermod root -s /bin/false

COPY ./k8s-rdma-shared-dp /usr/local/bin
COPY ./agreement.txt /usr/local/
COPY ./fault_code.json /etc/rdma-plugin/
COPY ./fault_detection.sh /etc/rdma-plugin/
COPY ./npu-nic-mapping.json /etc/rdma-plugin/

RUN chmod 550 /usr/local/bin/k8s-rdma-shared-dp &&\
    chmod 440 /usr/local/agreement.txt &&\
    chmod 550 /etc/rdma-plugin/fault_detection.sh &&\
    sed -i 's/\r$//' /etc/rdma-plugin/fault_detection.sh &&\
    echo 'umask 027' >> /etc/profile &&\
    echo 'source /etc/profile' >> ~/.bashrc

ENTRYPOINT ["/bin/bash", "-c", "cat /usr/local/agreement.txt; exec /bin/bash"]
