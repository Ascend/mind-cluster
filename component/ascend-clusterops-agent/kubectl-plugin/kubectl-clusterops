"""kubectl plugin: unified cluster operations entry (kubectl clusterops).

Business subcommands:
    tools
        list the registered capabilities (GET /tools)
    tool <name> [--param NAME=VALUE ...] [--params-json JSON]
        generic entry for every registered tool, driven by the GET /tools catalog
Management commands (unchanged):
    --create-llm-config [--base-url U] [--model M]
    --clear-llm-config

``kubectl ascend_diag`` remains the legacy diagnosis entry; no per-tool or
diagnosis alias subcommands are registered here.
"""

from __future__ import annotations

import argparse
import base64
import getpass
import json
import os
import re
import shutil
import subprocess
import sys

import clusterops_query_client as client

DEFAULT_NS = os.environ.get("ASCEND_CLUSTEROPS_NS", "mindx-dl")
SECRET_NAME = "llm-secret"  # nosec B105 - k8s resource name, not a hardcoded credential
SECRET_KEYS = ("api-key", "base-url", "model")  # consistent with the env references in agent-core.yaml

# collect manifest CM (consistent with node-collector's MANIFEST_CM contract)
MANIFEST_CM = os.environ.get("ASCEND_CLUSTEROPS_AGENT_COLLECT_MANIFEST_CM", "collect-manifest")
MANIFEST_NS = os.environ.get("ASCEND_CLUSTEROPS_AGENT_COLLECT_MANIFEST_NS", "cluster-system")
MANIFEST_KEY = "collect_manifest.yaml"

# Query tools with a dedicated human-readable renderer; every other tool falls back
# to a generic status/data view so a newly registered tool is usable without CLI changes.
_QUERY_RENDERERS = frozenset({"faulty_device", "isolated_device", "cluster_resource", "task_status"})


def _kubectl() -> str | None:
    return shutil.which("kubectl") or shutil.which("kubectl.exe")


def _update_collect_manifest(path: str) -> int:
    """Write a local collect_manifest.yaml into the cluster ConfigMap (create-or-replace, idempotent).

    Rendered via kubectl create --dry-run=client then applied; no extra Python library needed;
    the current kubeconfig needs create/apply permission on the ConfigMap's namespace.
    """
    kubectl = _kubectl()
    if not kubectl:
        print("error: kubectl not found, make sure it is installed and on PATH", file=sys.stderr)
        return 127
    if not os.path.isfile(path):
        print(f"error: collect manifest file does not exist: {path}", file=sys.stderr)
        return 1
    with open(path, "r", encoding="utf-8") as f:
        content = f.read()
    if not content.strip():
        print(f"error: collect manifest file is empty: {path}", file=sys.stderr)
        return 1
    render = [
        kubectl,
        "create",
        "configmap",
        MANIFEST_CM,
        "-n",
        MANIFEST_NS,
        f"--from-file={MANIFEST_KEY}={path}",
        "--dry-run=client",
        "-o",
        "yaml",
    ]
    r = subprocess.run(render, capture_output=True, text=True, check=False)
    if r.returncode != 0:
        print(f"error: failed to render collect manifest ConfigMap: {r.stderr.strip()}", file=sys.stderr)
        return 1
    apply_ = subprocess.run([kubectl, "apply", "-f", "-"], input=r.stdout, capture_output=True, text=True, check=False)
    if apply_.returncode != 0:
        print(f"error: failed to apply collect manifest ConfigMap: {apply_.stderr.strip()}", file=sys.stderr)
        return 1
    print(f"collect manifest written to ConfigMap {MANIFEST_CM}/{MANIFEST_NS}: {path}")
    print(
        "subsequent diagnostics will use the updated collect manifest "
        "(node-collector re-reads this CM on every collection, no restart needed)"
    )
    return 0


def create_llm_config(args: argparse.Namespace) -> int:
    """Configure llm-secret: build the manifest in memory (base64 data) and apply via stdin; nothing is written to disk and the key never enters argv."""
    kubectl = _kubectl()
    if not kubectl:
        print("error: kubectl not found on PATH", file=sys.stderr)
        return 127

    # prompt interactively when not provided via args/env; api-key/base-url/model are all required
    api_key = os.environ.get("LLM_API_KEY") or getpass.getpass("LLM API Key: ")
    base_url = args.base_url or os.environ.get("LLM_BASE_URL") or input("LLM Base URL: ")
    model = args.model or os.environ.get("LLM_MODEL") or input("LLM Model: ")
    if not api_key:
        print("error: missing api-key", file=sys.stderr)
        return 2
    if not base_url:
        print("error: missing base-url", file=sys.stderr)
        return 2
    if not model:
        print("error: missing model", file=sys.stderr)
        return 2

    # build the Secret manifest in memory (base64 data) and apply via stdin; nothing written to disk, key never enters argv
    manifest = {
        "apiVersion": "v1",
        "kind": "Secret",
        "metadata": {"name": SECRET_NAME, "namespace": DEFAULT_NS},
        "type": "Opaque",
        "data": {
            k: base64.b64encode(v.encode("utf-8")).decode("ascii")
            for k, v in zip(SECRET_KEYS, (api_key, base_url, model))
        },
    }
    try:
        applied = subprocess.run(
            [kubectl, "apply", "-f", "-"],
            input=json.dumps(manifest),
            capture_output=True,
            text=True,
            check=True,
            shell=False,
        )
    except subprocess.CalledProcessError as e:
        print(f"error: failed to apply llm-secret: {e.stderr.strip()}", file=sys.stderr)
        return 1

    print(applied.stdout.strip())
    # agent-core reads llm-secret via the k8s API on every call, taking effect immediately without a pod restart
    print("llm-secret updated, effective immediately")
    return 0


def clear_llm_config(args: argparse.Namespace) -> int:
    """Clear all LLM configuration: delete llm-secret (api-key/base-url/model removed together), effective immediately."""
    kubectl = _kubectl()
    if not kubectl:
        print("error: kubectl not found on PATH", file=sys.stderr)
        return 127
    try:
        deleted = subprocess.run(
            [kubectl, "-n", DEFAULT_NS, "delete", "secret", SECRET_NAME, "--ignore-not-found"],
            capture_output=True,
            text=True,
            check=True,
        )
    except subprocess.CalledProcessError as e:
        print(f"error: failed to delete llm-secret: {e.stderr.strip()}", file=sys.stderr)
        return 1

    print(deleted.stdout.strip() or f"{SECRET_NAME} does not exist, no LLM config to clear")
    # agent-core reads llm-secret via the k8s API on every call; once the secret is deleted it falls back to deterministic diagnosis
    print("LLM config cleared, effective immediately")
    return 0


