FROM openeuler/openeuler:24.03-lts

ARG UMDK_PKG=""

COPY ./${UMDK_PKG} /tmp

RUN yum update -y && \
    yum install -y shadow-utils libnl3-devel && \
    if [ -n "${UMDK_PKG}" ] && [ -f "/tmp/${UMDK_PKG}" ]; then \
        echo "installing umdk from /tmp/${UMDK_PKG}"; \
        mkdir /tmp/umdk_pkgs; \
        tar -mzxf "/tmp/${UMDK_PKG}" -C /tmp/umdk_pkgs; \
        rpm -ivh /tmp/umdk_pkgs/*.rpm; \
    else \
        echo "warning: umdk package not provided, install from yum"; \
        yum install -y umdk-urma-bin umdk-urma-devel umdk-urma-lib umdk-urma-tools; \
    fi && \
    yum clean all && \
    rm -rf /var/cache/yum && \
    rm -rf /tmp/*

RUN useradd -d /home/HwHiAiUser -u 1000 -m -s /usr/sbin/nologin HwHiAiUser && \
    usermod root -s /usr/sbin/nologin

ENV LD_LIBRARY_PATH /usr/local/Ascend/driver/lib64:/usr/local/Ascend/driver/lib64/driver:/usr/local/Ascend/driver/lib64/common

COPY ./ascend-dra /usr/local/bin/
# Staged at /tmp so the init container can publish it into the hostPath
# volume mounted at /etc/ascend-docker-runtime.d on each node.
COPY ./agreement.txt /usr/local/

RUN chmod 550 /usr/local/bin/ascend-dra && \
    chmod 550 /usr/local/bin && \
    chmod 440 /usr/local/agreement.txt && \
    chmod 750 /home/HwHiAiUser && \
    echo 'umask 027' >> /etc/profile && \
    echo 'source /etc/profile' >> ~/.bashrc

ENTRYPOINT ["/bin/bash", "-c", "cat /usr/local/agreement.txt; exec /bin/bash"]
