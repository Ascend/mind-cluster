FROM openeuler/openeuler:24.03-lts AS build

ARG VERSION=26.2.0
ARG TARGETPLATFORM

RUN yum update -y &&\
    yum install -y wget unzip &&\
    yum clean all &&\
    rm -rf /var/cache/yum &&\
    rm -rf /tmp/* &&\
    ARCH=$(case "${TARGETPLATFORM}" in \
        "linux/amd64") echo "x86_64" ;; \
        "linux/arm64") echo "aarch64" ;; \
        *) echo "Unsupported TARGETPLATFORM: ${TARGETPLATFORM}" && exit 1 ;; \
    esac) &&\
    wget https://gitcode.com/ascend/mind-cluster/releases/download/v${VERSION}/Ascend-mindxdl-dpu-exporter_${VERSION}_linux-${ARCH}.zip &&\
    unzip Ascend-mindxdl-dpu-exporter_${VERSION}_linux-${ARCH}.zip -d /build

FROM openeuler/openeuler:24.03-lts

RUN yum update -y && \
    yum install -y shadow-utils ca-certificates bash glibc libmnl && \
    yum clean all && \
    rm -rf /var/cache/yum

RUN useradd -d /home/HwHiAiUser -u 1000 -m -s /bin/false HwHiAiUser &&\
    usermod root -s /bin/false

COPY --from=build /build/dpu-exporter /usr/local/bin/
COPY --from=build /build/config.json /etc/dpu-exporter/config.json
COPY --from=build /build/agreement.txt /usr/local/

RUN chown root:root /usr/local/bin/dpu-exporter  &&\
    chmod 750 -R /home/HwHiAiUser &&\
    chmod 550 /usr/local/bin/ &&\
    chmod 500 /usr/local/bin/dpu-exporter &&\
    mkdir -p /etc/dpu-exporter &&\
    chmod 440 /etc/dpu-exporter/config.json &&\
    chmod 440 /usr/local/agreement.txt &&\
    echo 'umask 027' >> /etc/profile && \
    echo 'source /etc/profile' >> ~/.bashrc

ENTRYPOINT ["/bin/bash", "-c", "cat /usr/local/agreement.txt; exec /bin/bash"]
